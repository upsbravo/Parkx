
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    match /roles_super_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /super_admins/{superAdminId} {
       allow get: if isOwner(superAdminId) || isSuperAdmin();
       allow list: if isSuperAdmin();
       allow create: if isSuperAdmin();
       allow update: if isOwner(superAdminId) || isSuperAdmin();
       allow delete: if false; 
    }

    match /vendors/{vendorId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isOwner(vendorId);
      allow delete: if isSuperAdmin() && resource != null;

      match /endUsers/{userId} {
        allow get, list, update: if isOwner(vendorId) || isSuperAdmin();
        allow create: if isOwner(vendorId);
        allow delete: if (isOwner(vendorId) || isSuperAdmin()) && resource != null;
      }
      
      match /parking_spots/{parkingSpotId} {
        allow get: if isOwner(vendorId) || isSuperAdmin();
        allow list: if isOwner(vendorId) || isSuperAdmin();
        allow create: if (isOwner(vendorId) || isSuperAdmin()) && request.resource.data.vendorId == vendorId;
        allow update: if (isOwner(vendorId) || isSuperAdmin()) && resource != null && request.resource.data.vendorId == resource.data.vendorId;
        allow delete: if (isOwner(vendorId) || isSuperAdmin()) && resource != null;
      }
    }
    
    match /vendorInvoices/{invoiceId} {
      allow read, write: if isSuperAdmin();
    }
  }
}
