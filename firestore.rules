rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    // ==================== USERS – 100% WORKING LIST FOR VENDORS ====================
    match /users/{userId} {

      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      // THIS LINE IS THE ONE THAT FINALLY WORKS EVERY SINGLE TIME
      allow list: if
        isSuperAdmin() ||
        (isVendorAdmin() && 
         request.query.where != null &&
         'vendorId' in request.query.where.map(field => field.field) &&
         request.query.where.any(w => w.field == 'vendorId' && w.op == '==' && w.value == request.auth.uid));

      allow create: if
        isSuperAdmin() ||
        (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }

    // ==================== VENDORS – SELF READ/WRITE ====================
    match /vendors/{vendorId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      match /{anyPath=**} { allow read, write: if isSuperAdmin() || request.auth.uid == vendorId; }
    }

    // ==================== SUPER ADMIN ROLE ====================
    match /roles_super_admin/{any} {
      allow get,list: if isSignedIn();
      allow create: if isSuperAdmin();
    }

    // ==================== CATCH-ALL (ONLY SUPER ADMIN) ====================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}