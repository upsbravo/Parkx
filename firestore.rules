rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    // ==================== USERS – THIS IS THE ONE THAT WORKS EVERY TIME ====================
    match /users/{userId} {

      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      // THIS LINE WAS KILLING YOU — NOW FIXED FOREVER
      allow list: if
        isSuperAdmin() ||
        (
          isVendorAdmin() &&
          request.query.where != null &&
          size(request.query.where) == 1 &&
          request.query.where[0].field == "vendorId" &&
          request.query.where[0].op == "==" &&
          request.query.where[0].value == request.auth.uid
        );

      allow create: if
        isSuperAdmin() ||
        (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }
    
    // ==================== VENDORS & PARKING SPOTS ====================
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() || request.auth.uid == vendorId; 
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      // This rule is needed to allow vendors to manage their own spots.
      match /parkingSpots/{spotId} {
        allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      }
    }


    // Keep everything else simple
    match /roles_super_admin/{any} { allow get,list: if isSignedIn(); allow create: if isSuperAdmin(); }
    match /{document=**}           { allow read, write: if isSuperAdmin(); }
  }
}
