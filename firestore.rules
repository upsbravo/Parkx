
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }
    
    // Stripe Customers Collection
    // The Stripe extension needs to be able to create and manage customer objects.
    match /customers/{uid} {
      allow read, write: if true; // Allows the extension to write customer data
    }
    
    // SUPER ADMINS
    match /superAdmins/{superAdminId} {
      // Super admins can read and write their own profile
      allow get: if isSuperAdmin() && request.auth.uid == superAdminId;
      allow read, write: if isSuperAdmin() && request.auth.uid == superAdminId;
      
      // Super admins can manage their own notifications
      match /notifications/{notificationId} {
        allow read, write, list: if isSuperAdmin() && request.auth.uid == superAdminId;
      }
    }


    // VENDORS – self access + privileged read all + end-user read access
    match /vendors/{vendorId} {
      allow get: if request.auth == null || isSuperAdmin() || request.auth.uid == vendorId || isPrivilegedVendor() || (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId);
      allow list: if isSuperAdmin() || isPrivilegedVendor();
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      // End-users can read their own spot, admins can manage all spots
      match /parkingSpots/{spotId} {
        allow read: if
          isSuperAdmin() ||
          request.auth.uid == vendorId ||
          isPrivilegedVendor() ||
          resource.data.userId == request.auth.uid;
        allow write: if isSuperAdmin() || request.auth.uid == vendorId;
      }

      // Vendor Admins can manage invoices; End Users can only list their own
      match /userInvoices/{invoiceId} {
          allow read: if request.auth.uid == vendorId || (resource.data.userId == request.auth.uid);
          // Allow server-side processes to write
          allow write: if request.auth.uid == vendorId || request.auth == null;
          allow list: if (isVendorAdmin() && request.auth.uid == vendorId) ||
                         (isSignedIn() && request.query.where.userId == request.auth.uid);
      }

      // Vendor Admins can manage documents for their own users, and users can create their own.
      match /userDocuments/{docId} {
        allow read, list, update, delete: if isVendorAdmin() && request.auth.uid == vendorId;
        allow create: if (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid) ||
                         (isSignedIn() && request.resource.data.userId == request.auth.uid);
      }
      
      // VENDOR <> SUPER ADMIN MESSAGES
      match /support-messages/{messageId} {
        allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      }
      
      // VENDOR'S OWN DOCUMENTS
      match /vendorDocuments/{docId} {
        allow read, write: if request.auth.uid == vendorId || isSuperAdmin();
      }
      
      // PAYOUTS - Only readable by owner and super admin, not writable from client
      match /payouts/{payoutId} {
        allow read: if isSuperAdmin() || request.auth.uid == vendorId;
        allow list: if isSuperAdmin() || request.auth.uid == vendorId;
        allow write: if false; // Only backend can create/update payouts
      }

      // VENDOR ANNOUNCEMENTS - Vendor can manage, their users can read
      match /announcements/{announcementId} {
        allow read, list: if (isVendorAdmin() && request.auth.uid == vendorId) ||
                           (isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId);
        allow write: if isVendorAdmin() && request.auth.uid == vendorId;
      }

      // VENDOR NOTIFICATIONS
      match /notifications/{notificationId} {
        allow read, write, list: if isVendorAdmin() && request.auth.uid == vendorId;
        // Super Admins can create notifications for vendors (e.g. for approvals)
        allow create: if isSuperAdmin();
      }
    }

    // USERS – privileged vendors see all, normal vendors see only theirs
    match /users/{userId} {
      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                      (isVendorAdmin() && request.query.where.vendorId == request.auth.uid);

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
        
      // VENDOR <> USER MESSAGES
      match /messages/{messageId} {
        // End user can read/write their own messages
        allow read, write: if request.auth.uid == userId;

        // Their vendor admin can also read/write
        allow read, write: if 
          isVendorAdmin() &&
          get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid;

        // Super admin sees everything
        allow read, write: if isSuperAdmin();
      }
      
      // USER NOTIFICATIONS
      match /notifications/{notificationId} {
        // A user can read, write, and list their own notifications.
        allow read, write, list: if request.auth.uid == userId;

        // A vendor admin can create a notification for their own user.
        allow create: if 
            isVendorAdmin() &&
            get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid;
      }
       
      // SMS LOGS
      match /sms_logs/{logId} {
        // Allow server-side (unauthenticated) writes, or client-side writes from the user's vendor
        allow create: if request.auth == null || (isVendorAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid);
        allow read, list: if request.auth.uid == userId || (isVendorAdmin() && get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid);
      }
       
      // CHECKOUT SESSIONS
      // Allow user to create and read their own checkout sessions
      match /checkout_sessions/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }
    }
    
    // VENDOR INVOICES (COLLECTION GROUP)
    // This top-level rule is required for the collectionGroup query in the Financial Summary page.
    match /{path=**}/vendorInvoices/{invoiceId} {
      // Allow Super Admin to query across ALL vendor invoices
      allow get, list: if isSuperAdmin();

      // Allow individual vendors to read their own invoices, and super admins to create/update them
      allow read, write: if (isVendorAdmin() && request.auth.uid == get(/databases/$(database)/documents/$(path)).data.id) || isSuperAdmin() || request.auth == null;
    }
    
    // Stripe Transactions - VENDORS CAN SEE ONLY THEIR OWN
    match /transactions/{transactionId} {
      // Single document read
      allow get: if isSuperAdmin() || 
                    (isVendorAdmin() && resource.data.vendorId == request.auth.uid);

      // LIST queries (this is what your useCollection uses!)
      allow list: if isSuperAdmin() || isPrivilegedVendor() || 
                     (isVendorAdmin() && request.query.where.vendorId == request.auth.uid && request.query.orderBy.keys().hasOnly(['created']));

      // Only backend (Stripe extension, Cloud Functions) can write
      allow create, update, delete: if false;
    }
    
    // GLOBAL ANNOUNCEMENTS
    match /announcements/{announcementId} {
        // Anyone can read
        allow get, list: if true;
        // Only super admins can write
        allow write: if isSuperAdmin();
    }

    match /roles_super_admin/{uid} {
      allow read, list: if isSignedIn();
      allow create: if isSuperAdmin();
    }

    // Catch-all for other collections - restricted to Super Admin
    match /{path=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
