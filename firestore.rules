
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }
    
    // Stripe Customers Collection
    // The Stripe extension needs to be able to create and manage customer objects.
    match /customers/{uid} {
      allow read, write: if request.auth.uid == uid;
    }

    // VENDORS – self access + privileged read all + end-user read access
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() ||
                     request.auth.uid == vendorId ||
                     isPrivilegedVendor() ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId);
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      // End-users can read their own spot, admins can manage all spots
      match /parkingSpots/{spotId} {
        allow read: if
          isSuperAdmin() ||
          request.auth.uid == vendorId ||
          isPrivilegedVendor() ||
          resource.data.userId == request.auth.uid;
        allow write: if isSuperAdmin() || request.auth.uid == vendorId;
      }

      // Vendor Admins can manage invoices; End Users can only list their own
      match /userInvoices/{invoiceId} {
          allow read: if request.auth.uid == vendorId || (resource.data.userId == request.auth.uid);
          // Allow server-side processes to write
          allow write: if request.auth.uid == vendorId || request.auth == null;
          allow list: if (isVendorAdmin() && request.auth.uid == vendorId) ||
                         (isSignedIn() && request.query.where.userId == request.auth.uid);
      }

      // Vendor Admins can manage documents for their own users
      match /userDocuments/{docId} {
        allow read, list, write: if request.auth.uid == vendorId || (exists(/databases/$(database)/documents/users/$(resource.data.userId)) && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.vendorId == request.auth.uid) || request.auth.uid == resource.data.userId;
      }
      
      // VENDOR <> SUPER ADMIN MESSAGES
      match /support-messages/{messageId} {
        allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      }
      
      // VENDOR'S OWN DOCUMENTS
      match /vendorDocuments/{docId} {
        allow read, write: if request.auth.uid == vendorId || isSuperAdmin();
      }
      
      // PAYOUTS - Only readable by owner and super admin, not writable from client
      match /payouts/{payoutId} {
        allow read: if isSuperAdmin() || request.auth.uid == vendorId;
        allow list: if isSuperAdmin() || request.auth.uid == vendorId;
        allow write: if false; // Only backend can create/update payouts
      }
    }

    // USERS – privileged vendors see all, normal vendors see only theirs
    match /users/{userId} {
      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                      (isVendorAdmin() && request.query.where.vendorId == request.auth.uid);

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
        
      // VENDOR <> USER MESSAGES
      match /messages/{messageId} {
        // End user can read/write their own messages
        allow read, write: if request.auth.uid == userId;

        // Their vendor admin can also read/write
        allow read, write: if 
          isVendorAdmin() &&
          get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid;

        // Super admin sees everything
        allow read, write: if isSuperAdmin();
      }
      
      // USER NOTIFICATIONS
      match /notifications/{notificationId} {
        // A user can read, write, and list their own notifications.
        allow read, write, list: if request.auth.uid == userId;
      }
    }
    
    // Allow vendors to list their own invoices, and super admins to see all
    match /vendorInvoices/{invoiceId} {
      allow read: if isSuperAdmin() || (isVendorAdmin() && resource.data.vendorId == request.auth.uid);
      allow list: if isSuperAdmin() || (isVendorAdmin() && request.query.where.vendorId == request.auth.uid);
      allow write: if isSuperAdmin();
    }
    
    // Stripe Transactions
    match /transactions/{transactionId} {
        allow read: if isSuperAdmin() || (isVendorAdmin() && resource.data.vendorId == request.auth.uid);
        allow list: if isSuperAdmin() || (isVendorAdmin() && request.query.where.vendorId == request.auth.uid);
        // Only allow creation via backend functions (Stripe Extension)
        allow create, update, delete: if false;
    }

    match /roles_super_admin/{any} { allow get,list: if isSignedIn(); allow create: if isSuperAdmin(); }

    // Catch-all for other collections - restricted to Super Admin
    match /{path=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
