rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    // ==================== VENDORS – VENDOR CAN READ THEIR OWN DOC ====================
    match /vendors/{vendorId} {
      allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;

      match /parkingSpots/{any} {
        allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      }
    }

    // ==================== USERS – ALREADY PERFECT ====================
    match /users/{userId} {
      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if
        isSuperAdmin() ||
        (
          isVendorAdmin() &&
          request.query.where != null &&
          size(request.query.where) == 1 &&
          request.query.where[0].field == "vendorId" &&
          request.query.where[0].op == "==" &&
          request.query.where[0].value == request.auth.uid
        );

      allow create: if
        isSuperAdmin() ||
        (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }

    // ==================== SUPER ADMIN ROLE ====================
    match /roles_super_admin/{any} {
      allow get,list: if isSignedIn();
      allow create: if isSuperAdmin();
    }

    // ==================== REMOVE THE CATCH-ALL OR PUT IT LAST ====================
    // Only super admin can touch anything not explicitly allowed above
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
