
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() && get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }

    // ==================== VENDORS – vendor can read/write his own profile ====================
    match /vendors/{vendorId} {
      allow list: if isSuperAdmin() || isPrivilegedVendor();
      allow read, write: if isSuperAdmin() || request.auth.uid == vendorId;
      match /{anyPath=**} { allow read, write: if isSuperAdmin() || request.auth.uid == vendorId; }
    }

    // ==================== USERS – THIS IS THE ONE THAT WORKS 100% ====================
    match /users/{userId} {

      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      // THIS LINE IS THE FINAL ONE – WORKS EVERY TIME
      allow list: if isSuperAdmin() || (isVendorAdmin() && 
        request.query.where != null &&
        request.query.where.hasAny(['vendorId']) &&
        request.query.where.vendorId == request.auth.uid);

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }

    match /roles_super_admin/{any} { allow get,list: if isSignedIn(); allow create: if isSuperAdmin(); }

    // Everything else → only super admin
    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
