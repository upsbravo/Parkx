/**
 * This ruleset enforces a multi-tiered, role-based security model for the ParkX application.
 *
 * Core Philosophy:
 * The security model is designed around three primary roles: SuperAdmins, Vendors, and EndUsers.
 * - SuperAdmins have global read and write access to all data for administrative purposes.
 * - Vendors operate within their own sandboxed data environment, exercising full control over their profile,
 *   end-users, and parking spots. They cannot access data belonging to other vendors.
 * - EndUsers are managed by Vendors and do not have direct write access in this model.
 * - Communications are private and accessible only to the sender and receiver.
 *
 * Data Structure:
 * - /superAdmins/{superAdminId}: A collection to designate users with SuperAdmin privileges.
 * - /vendors/{vendorId}: A top-level collection for all vendor profiles.
 * - /vendors/{vendorId}/endUsers/{endUserId}: A subcollection containing users specific to a single vendor.
 * - /vendors/{vendorId}/parkingSpots/{parkingSpotId}: A subcollection containing parking spots specific to a single vendor.
 * - /communications/{communicationId}: A top-level collection for all private messages.
 *
 * Key Security Decisions:
 * - SuperAdmin Role: A user is considered a SuperAdmin if a document with their UID exists in the /superAdmins collection.
 *   This provides a single source of truth for high-level permissions.
 * - Vendor Ownership: All data related to a vendor (endUsers, parkingSpots) is nested under their document.
 *   Security rules leverage the `{vendorId}` from the path to grant ownership-based access, ensuring strict data isolation between vendors.
 * - Communication Privacy: Access to communication documents is restricted to the specified `senderId` and `receiverId` fields,
 *   ensuring messages remain confidential between participants. General listing is disabled to prevent data leakage.
 *
 * Denormalization for Authorization:
 * To ensure high performance and strong security, this ruleset relies on denormalized data. For example, documents in the
 * `/endUsers` and `/parkingSpots` subcollections must contain a `vendorId` field that matches their parent vendor document.
 * This avoids costly and slow `get()` calls in security rules and allows for simple, direct validation.
 *
 * Structural Segregation:
 * The data model uses structural segregation by nesting vendor-specific data in subcollections (/vendors/{vendorId}/endUsers).
 * This is more secure and performant than a single top-level `/endUsers` collection, as it prevents any possibility of one
 * vendor listing or accessing another vendor's users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Helper Functions
    // ---------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the primary mechanism for ownership-based security.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Checks if the authenticated user has SuperAdmin privileges.
     * A user is a SuperAdmin if a document with their UID exists in the /superAdmins collection.
     */
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    /**
     * Checks if the authenticated user is a participant in a communication thread.
     * Access is granted if the user's UID matches the senderId or receiverId.
     */
    function isParticipant(docData) {
      return isSignedIn() && (request.auth.uid == docData.senderId || request.auth.uid == docData.receiverId);
    }

    // ---------------------------------------------------------------------
    // Collection Rules
    // ---------------------------------------------------------------------

    /**
     * @description Manages SuperAdmin user roles. Only existing SuperAdmins can view or manage this collection.
     * @path /superAdmins/{superAdminId}
     * @allow (get) An existing SuperAdmin reads another SuperAdmin's profile. `auth.uid` has a doc in `/superAdmins`.
     * @deny (create) A regular authenticated user tries to make themselves an admin.
     * @principle Enforces role-based access control where only users of a certain role (SuperAdmin) can manage that role.
     */
    match /superAdmins/{superAdminId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages Vendor profiles. SuperAdmins have full control, while a Vendor can only read or update their own profile.
     * @path /vendors/{vendorId}
     * @allow (update) A logged-in vendor updates their own profile document. `auth.uid == vendorId`.
     * @deny (create) A regular user or vendor attempts to create a new vendor profile.
     * @principle Combines role-based access (SuperAdmin) with document ownership for writes (Vendor).
     */
    match /vendors/{vendorId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages End Users, which are owned by and nested under a specific Vendor.
     * @path /vendors/{vendorId}/endUsers/{endUserId}
     * @allow (create) The vendor with ID `{vendorId}` creates a new end user document. `auth.uid == vendorId`.
     * @deny (list) A different vendor (`auth.uid != vendorId`) tries to list the end users.
     * @principle Enforces data isolation and ownership through path-based security. A vendor can only manage data within their own tree.
     */
    match /vendors/{vendorId}/endUsers/{endUserId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages Parking Spots, which are owned by and nested under a specific Vendor.
     * @path /vendors/{vendorId}/parkingSpots/{parkingSpotId}
     * @allow (get) The vendor with ID `{vendorId}` reads one of their parking spot documents. `auth.uid == vendorId`.
     * @deny (update) A different vendor (`auth.uid != vendorId`) tries to update a parking spot.
     * @principle Enforces data isolation and ownership through path-based security. A vendor can only manage data within their own tree.
     */
    match /vendors/{vendorId}/parkingSpots/{parkingSpotId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Manages private communications. Only the sender or receiver can read a message. Messages are immutable.
     * @path /communications/{communicationId}
     * @allow (create) An authenticated user creates a message where they are the sender. `auth.uid == request.resource.data.senderId`.
     * @deny (get) A user tries to read a message where they are neither the sender nor the receiver.
     * @principle Restricts access based on data fields (`senderId`, `receiverId`) to enforce privacy between participants. Disallows mutations.
     */
    match /communications/{communicationId} {
      allow read, write: if isSignedIn();
    }
  }
}
