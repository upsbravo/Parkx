
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────── Helpers ──────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(id) { return request.auth.uid == id; }

    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    // True if the current logged-in vendor owns this end-user
    function isMyCustomer(userId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid;
    }

    // ────────────────────── Super Admin Role ──────────────────────
    match /roles_super_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ────────────────────── Vendors ──────────────────────
    match /vendors/{vendorId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() || isOwner(vendorId);
      allow delete: if isSuperAdmin();

      match /parking_spots/{spotId} {
        allow get, list: if isSignedIn();
        allow create, update, delete: if isSuperAdmin() || isOwner(vendorId);
      }
    }

    // ────────────────────── End Users (top-level) ──────────────────────
    match /users/{userId} {
      // Anyone can read their own document, their vendor, or super-admin
      allow get: if isOwner(userId) || isSuperAdmin() || isMyCustomer(userId);

      // Vendor can list ONLY their own customers
      allow list: if isSuperAdmin() ||
                     (isSignedIn() && 
                      request.query.where != null &&
                      request.query.where[0].field == "vendorId" &&
                      request.query.where[0].op == "==" &&
                      request.query.where[0].value == request.auth.uid);

      // Vendor can create a customer for themselves
      allow create: if isSuperAdmin() ||
                       (isSignedIn() && request.resource.data.vendorId == request.auth.uid);

      // Owner, their vendor, or super-admin can update/delete
      allow update, delete: if isOwner(userId) || isSuperAdmin() || isMyCustomer(userId);
    }

    // ────────────────────── Everything else (invoices, etc.) ──────────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
