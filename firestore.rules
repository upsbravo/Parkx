
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== BASIC HELPERS ====================
    function isSignedIn() { return request.auth != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }

    function isParticipant(convId) {
      return request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
    }

    // ==================== VENDORS + SUBCOLLECTIONS ====================
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() ||
                     request.auth.uid == vendorId ||
                     isPrivilegedVendor() ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId);

      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      match /parkingSpots/{spotId} {
        allow read: if isSuperAdmin() || request.auth.uid == vendorId || isPrivilegedVendor() ||
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSpotId == spotId);
        allow write: if isSuperAdmin() || request.auth.uid == vendorId;
      }

      match /userInvoices/{any}   { allow read, list, write: if request.auth.uid == vendorId; }
      match /userDocuments/{doc}  { allow read, list, write: if request.auth.uid == vendorId || request.auth.uid == resource.data.userId; }
    }

    // ==================== USERS ====================
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin() || isPrivilegedVendor() ||
                   (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                    (isVendorAdmin() &&
                     request.query.where != null &&
                     request.query.where.hasAny([["vendorId", "==", request.auth.uid]]));

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);
      allow update, delete: if request.auth.uid == userId || isSuperAdmin() || isPrivilegedVendor() ||
                              (resource != null && resource.data.vendorId == request.auth.uid);
    }

    // ==================== CONVERSATIONS & MESSAGES – BULLETPROOF 2025 EDITION ====================
    match /conversations/{conversationId} {

      allow get:    if isSuperAdmin() || isParticipant(conversationId);

      // This works with orderBy, limit, startAfter, everything
      allow list:   if isSuperAdmin() ||
                      (request.query.where != null &&
                       request.query.where.hasAny([["participants", "array-contains", request.auth.uid]]));

      allow create: if isSuperAdmin() || (request.auth.uid in request.resource.data.participants);
      allow update: if isSuperAdmin() || isParticipant(conversationId);

      match /messages/{messageId} {
        allow read, write: if isSuperAdmin() || isParticipant(conversationId);
      }
    }

    // ==================== SUPER ADMIN ROLE ====================
    match /roles_super_admin/{any} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
    }

    // ==================== CATCH-ALL ====================
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
