
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────────── Helpers ──────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(id) { return request.auth.uid == id; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isMyCustomer(userId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.vendorId == request.auth.uid;
    }

    // ────────────────────── Super Admin Role ──────────────────────
    match /roles_super_admin/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ────────────────────── Vendors ──────────────────────
    match /vendors/{vendorId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin() || isOwner(vendorId);
      allow delete: if isSuperAdmin();

      match /parking_spots/{spotId} {
        allow get, list, create, update, delete: if isSuperAdmin() || isOwner(vendorId);
      }
    }

    // ────────────────────── End Users – THIS IS THE IMPORTANT PART ──────────────────────
    match /users/{userId} {
      // READ single document
      allow get: if isOwner(userId) || isSuperAdmin() || isMyCustomer(userId);

      // LIST – the exact rule that was blocking your vendor admin page
      allow list: if 
        isSuperAdmin() ||
        (
          isSignedIn() &&
          request.query.where != null &&
          size(request.query.where) == 1 &&
          request.query.where[0].field == "vendorId" &&
          request.query.where[0].op == "==" &&
          request.query.where[0].value == request.auth.uid
        );

      // CREATE – vendor can create their own customers
      allow create: if isSuperAdmin() ||
                       (isSignedIn() && request.resource.data.vendorId == request.auth.uid);

      // UPDATE / DELETE
      allow update, delete: if isOwner(userId) || isSuperAdmin() || isMyCustomer(userId);
    }

    // ────────────────────── Everything else (invoices, etc.) ──────────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
