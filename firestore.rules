rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ────────────────── BASIC HELPERS ──────────────────
    function isSignedIn() { return request.auth != null; }
    function isSuperAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }
    function isVendorAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }
    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }

    // ────────────────── CONVERSATIONS & MESSAGES (THIS IS THE FIX) ──────────────────
    match /conversations/{conversationId} {

      // GET single conversation document
      allow get: if isSuperAdmin() ||
                    request.auth.uid in resource.data.participants;

      // LIST conversations — works with orderBy, limit, etc.
      allow list: if isSuperAdmin() ||
                     (request.query.where != null &&
                      request.query.where.hasAny([["participants", "array-contains", request.auth.uid]]));

      // CREATE new conversation
      allow create: if isSuperAdmin() ||
                       request.auth.uid in request.resource.data.participants;

      // UPDATE conversation (last message, unread count, etc.)
      allow update: if isSuperAdmin() ||
                       request.auth.uid in resource.data.participants;

      // ───── MESSAGES SUBCOLLECTION ─────
      match /messages/{any=**} {
        allow read, write: if isSuperAdmin() ||
                              request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // ────────────────── VENDORS ──────────────────
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() || request.auth.uid == vendorId || isPrivilegedVendor() ||
                     (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId);
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      match /{any=**} { allow read, write: if isSuperAdmin() || request.auth.uid == vendorId; }
    }

    // ────────────────── USERS ──────────────────
    match /users/{userId} {
      allow get: if request.auth.uid == userId || isSuperAdmin() || isPrivilegedVendor() ||
                   (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                    (isVendorAdmin() && request.query.where != null &&
                     request.query.where.hasAny([["vendorId", "==", request.auth.uid]]));

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);
      allow update, delete: if request.auth.uid == userId || isSuperAdmin() || isPrivilegedVendor() ||
                              (resource != null && resource.data.vendorId == request.auth.uid);
    }

    // ────────────────── SUPER ADMIN ROLE ──────────────────
    match /roles_super_admin/{any} {
      allow get, list: if isSignedIn();
      allow create: if isSuperAdmin();
    }

    // ────────────────── CATCH-ALL ──────────────────
    match /{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
