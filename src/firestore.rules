
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth.uid != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }

    function isParticipant(conversationId) {
      return isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // VENDORS – self access + privileged read all
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() || 
                   request.auth.uid == vendorId || 
                   isPrivilegedVendor() ||
                   (
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId
                   );
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      // End-users can read their own spot, admins can manage all spots
      match /parkingSpots/{spotId} {
        allow read: if
          isSuperAdmin() ||
          request.auth.uid == vendorId ||
          isPrivilegedVendor() ||
          resource.data.userId == request.auth.uid;
        allow write: if isSuperAdmin() || request.auth.uid == vendorId;
      }

      // Vendor Admins can manage invoices within their own subcollection
      match /userInvoices/{invoiceId} { allow read, list, write: if request.auth.uid == vendorId; }
      
      // Vendor Admins can manage documents for their own users
      match /userDocuments/{docId} { 
        allow read, list, write: if request.auth.uid == vendorId || (exists(/databases/$(database)/documents/users/$(resource.data.userId)) && get(/databases/$(database)/documents/users/$(resource.data.userId)).data.vendorId == request.auth.uid) || request.auth.uid == resource.data.userId;
      }
    }

    // USERS – privileged vendors see all, normal vendors see only theirs
    match /users/{userId} {
      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                      (isVendorAdmin() && request.query.where != null &&
                       size(request.query.where) > 0 &&
                       request.query.where[0].field == "vendorId" &&
                       request.query.where[0].op == "==" &&
                       request.query.where[0].value == request.auth.uid);

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }
    
    // CONVERSATIONS - new secure rules
    match /conversations/{conversationId} {
      // Allow a user to get a conversation if they are a participant.
      allow get: if isParticipant(conversationId);

      // Allow a user to list conversations only if they are querying for conversations they are a part of.
      allow list: if isSignedIn() && request.query.where != null && size(request.query.where) > 0 && request.query.where[0].field == "participants" && request.query.where[0].op == "array-contains" && request.query.where[0].value == request.auth.uid;
      
      // Allow create if the user is one of the participants being added.
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      
      // MESSAGES SUBCOLLECTION - secured by the parent conversation's security
      match /messages/{messageId} {
        // Allow read and write if the user is a participant of the parent conversation.
        // This is safe because the ability to know the {conversationId} is already secured by the rules on the /conversations collection.
        allow read, write: if isParticipant(conversationId);
      }
    }

    match /roles_super_admin/{any} { allow get,list: if isSignedIn(); allow create: if isSuperAdmin(); }

    // Catch-all for other collections
    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
