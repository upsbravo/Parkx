
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth.uid != null; }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/roles_super_admin/$(request.auth.uid));
    }

    function isVendorAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function isPrivilegedVendor() {
      return isVendorAdmin() &&
        get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data.isPrivileged == true;
    }

    // VENDORS – self access + privileged read all + end-user read own vendor
    match /vendors/{vendorId} {
      allow read: if isSuperAdmin() || 
                   request.auth.uid == vendorId || 
                   isPrivilegedVendor() ||
                   (
                     exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.vendorId == vendorId
                   );
      allow write: if isSuperAdmin() || request.auth.uid == vendorId;

      // End-users can read their own spot, admins can manage all spots
      match /parkingSpots/{spotId} {
        allow read: if
          isSuperAdmin() ||
          request.auth.uid == vendorId ||
          isPrivilegedVendor() ||
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSpotId == spotId
          );
        allow write: if isSuperAdmin() || request.auth.uid == vendorId;
      }

      // Vendor Admins can manage invoices within their own subcollection
      match /userInvoices/{invoiceId} { allow read, list, write: if request.auth.uid == vendorId; }
      
      // Vendor Admins can manage documents for their own users
      match /userDocuments/{docId} { 
        allow read, list, write: if request.auth.uid == vendorId || request.auth.uid == resource.data.userId;
      }
    }

    // USERS – privileged vendors see all, normal vendors see only theirs
    match /users/{userId} {
      allow get: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);

      allow list: if isSuperAdmin() || isPrivilegedVendor() ||
                      (isVendorAdmin() && request.query.where != null &&
                       size(request.query.where) > 0 &&
                       request.query.where[0].field == "vendorId" &&
                       request.query.where[0].op == "==" &&
                       request.query.where[0].value == request.auth.uid);

      allow create: if isSuperAdmin() || (isVendorAdmin() && request.resource.data.vendorId == request.auth.uid);

      allow update, delete: if
        request.auth.uid == userId ||
        isSuperAdmin() ||
        isPrivilegedVendor() ||
        (resource != null && resource.data.vendorId == request.auth.uid);
    }
    
    // User Documents: End user can read their own documents. Vendor Admin can also read.
    match /vendors/{vendorId}/userDocuments/{docId} {
        allow read: if request.auth.uid == resource.data.userId || request.auth.uid == vendorId;
        allow list: if request.auth.uid == vendorId || (request.query.where != null && request.auth.uid == request.query.where.userId);
        allow write: if request.auth.uid == vendorId || request.auth.uid == request.resource.data.userId;
    }

    // CONVERSATIONS - new secure rules
    match /conversations/{conversationId} {
      // Allow read/list if the user is a participant
      allow read, list: if isSignedIn() && request.auth.uid in resource.data.participants;
      // Allow create if the user is one of the participants
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      
      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        // Inherit read/write access from parent conversation
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /roles_super_admin/{any} { allow get,list: if isSignedIn(); allow create: if isSuperAdmin(); }

    // Catch-all for other collections
    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}

    