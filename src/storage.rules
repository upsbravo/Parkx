rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow anyone to read public files
    match /public/{allPaths=**} {
      allow read;
    }

    // Allow vendor admins to upload their own logo
    match /vendors/{vendorId}/logo/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }
    
    // Allow super admins and vendor admins to write to any folder under /communications
    match /communications/{superAdminId}/{vendorId}/{allPaths=**} {
      allow read, write: if request.auth != null && (
        exists(/databases/(default)/documents/roles_super_admin/$(request.auth.uid)) ||
        request.auth.uid == vendorId
      );
    }

    // Allow end users to write to their specific folder under their vendor's communications
    match /communications/{vendorId}/{userId}/{allPaths=**} {
       allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow authenticated users to upload their own files
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

    