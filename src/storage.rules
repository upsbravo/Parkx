
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow vendor admins to upload their own logo
    match /vendors/{vendorId}/logo/{fileName} {
      allow read;
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Default deny all other paths for now
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
