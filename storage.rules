rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Allow vendor admins to upload their own logo
    match /vendors/{vendorId}/logo/{fileName} {
      allow read: if true;   // or if request.auth != null if you want only signed-in
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Optional: allow users to upload their own documents, profile pics, etc.
    // match /users/{userId}/{allPaths=**} {
    //   allow read, write: if request.auth != null && request.auth.uid == userId;
    // }

    // Default deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}