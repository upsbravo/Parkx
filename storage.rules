
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow vendor admins to upload their own logo.
    // The user must be authenticated and their UID must match the {vendorId} in the path.
    match /vendors/{vendorId}/logo/{fileName} {
      allow read: if true; // Logos are often public.
      allow write: if request.auth != null && request.auth.uid == vendorId;
    }

    // Allow authenticated users to upload their own files (e.g., truck images).
    // The user must be authenticated and their UID must match the {userId} in the path.
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null; // Allow reading of user-uploaded files
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Default deny all other paths for added security.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
